PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/codealpha_pm for local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codealpha_pm?retryWrites=true&w=majority

# Any long random string — generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS and Socket.io (comma-separated)
CLIENT_URL=http://localhost:5173
